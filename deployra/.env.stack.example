# Sao chép thành .env rồi sửa. KHÔNG commit file .env.
DB_USER=deployra
DB_PASSWORD=doi-mat-khau-manh-o-day

# Tạo bằng: openssl rand -base64 32
DEPLOYRA_CRYPTO_KEY=

# Domain gốc: service có URL https://{slug}.BASE_DOMAIN, API ở APP_DOMAIN
BASE_DOMAIN=deployra.localhost
APP_DOMAIN=api.deployra.localhost
ACME_EMAIL=ban@example.com
AWS_REGION=ap-southeast-1

DEPLOYRA_ADMIN_EMAILS=demo@deployra.local
# update khi chưa có Flyway; validate khi đã có V1__baseline.sql
DDL_AUTO=update
